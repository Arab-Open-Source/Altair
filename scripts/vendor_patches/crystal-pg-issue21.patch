+    # Stable named-statement name for *sql* on this physical connection.
+    # Distinct SQL text always maps to a distinct name, so two statements can
+    # never bind into each other's portal.
+    def prepared_name(sql : String) : String
+      synchronize do
+        name = @prepared_names[sql]?
+        return name if name
+
+        if @prepared_counter >= PREPARED_NAME_CAP
+          # Name space exhausted: reset both sides. The next Parse of a reused
+          # name redefines the server-side statement, so no DEALLOCATE needed.
+          @prepared_names.clear
+          @registered_names.clear
+          @prepared_counter = 0
+        end
+        name = "altair_#{@prepared_counter += 1}"
+        @prepared_names[sql] = name
+        name
+      end
+    end
+
+    def registered?(name : String) : Bool
