<h1>Edit product</h1>
<% product.errors.full_messages.each do |message| %>
  <p style="color:#a11"><%= message %></p>
<% end %>
<form action="/products/<%= product.id %>" method="post">
  <input type="hidden" name="_method" value="PUT">
  <label>Name <input name="name" value="<%= product.name %>"></label>
  <label>Price <input name="price" type="number" min="0.01" step="0.01" value="<%= product.price %>"></label>
  <button type="submit">Save product</button>
</form>
