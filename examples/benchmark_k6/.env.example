# Optional overrides for docker-compose.yml.
# Benchmark load is tuned here too (VUs + phases).

# CPU / memory granted to each application container. PostgreSQL is always
# pinned to 2 CPUs / 2 GB inside the compose file.
BENCH_APP_CPUS=2.0
BENCH_APP_MEM=768M

# k6 load profile (seconds, virtual users).
BENCH_WARMUP=5
BENCH_DURATION=30
BENCH_VUS_WRITE=50
BENCH_VUS_READ=50